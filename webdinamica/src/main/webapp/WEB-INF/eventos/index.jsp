<%@ page import="java.util.List" %>
<%@ page import="logica.DTEvento" %>
<%@ page import="logica.DTUsuario" %>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Eventos.uy - Inicio</title>
  
  <link rel="stylesheet" href="/webdinamica/assets/styles.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="icon" type="image/png" href="assets/logoChico.png">
</head>
<body>
  <%@ include file="/components/header.jsp" %>

  <main>
    <%@ include file="/components/sidebar.jsp" %>
  	<div class="container py-3">
	  	<div class="row gy-3">
		
		<!-- Para todas las categorias -->
		<%
		String categoria = request.getParameter("categoria");
		List<DTEvento> eventos = (List<DTEvento>) request.getAttribute("eventos");
	    
		
    	for (DTEvento e : eventos) { %>
	      <div class="col-sm-6">
		      <div class="card">
		        <div class="d-flex justify-content-center align-items-center h-100">
		          <% if (e.getImagen() != null) { %>
		          	<img src="/webdinamica/uploads/<%= e.getImagen() %>" class="custom-card-img" alt="<%= e.getNombre() %>">
	        	  <% } else {%>
	          		<img src="data:image/png;base64," class="custom-card-img" alt="<%= e.getNombre() %>">
       			  <% } %>
        		</div>
		        <div class="card-body">
		          <h5 class="card-title"><%= e.getNombre() %></h5>
		          <p class="card-text"><%= e.getDescripcion() %></p>
		          <a href="eventos/consultaEvento?evento=<%= e.getNombre() %>" class="btn btn-primary">Más información</a>
		        </div>
		      </div>
		  </div>
		<%
    	}
		%>
		

		
	
	    </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
